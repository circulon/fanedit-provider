# Copy to .env and adjust as needed - every value here matches the
# documented default in app/helper/config.py.

# --- Matching/scoring thresholds (0-100) --------------------------------
MINIMUM_EXACT_SCORE=90
MINIMUM_MANUAL_SCORE=70

# --- Misc ----------------------------------------------------------------
INCLUDE_EXTRA_IN_SUMMARY=true

# --- Caches ----------------------------------------------------------------
ENTRY_CACHE_TTL_SECONDS=60
ENTRY_CACHE_MAX_SIZE=200
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_CACHE_MAX_SIZE=100

# --- Server ----------------------------------------------------------------
PORT=32900
WORKERS=2
THREADS=4
DEBUG=false
LOG_LEVEL=INFO
